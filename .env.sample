# Used by bash ./install.sh. Empty values are asked for.

# Domain of ntfy, e.g. ntfy.example.com
NTFY_DOMAIN=

# ntfy image tag
NTFY_VERSION=v2.37.2

# Optional image repository, for a mirror (default: binwiederhier/ntfy)
# NTFY_IMAGE=

# How long the server keeps messages for clients that reconnect
NTFY_CACHE_DURATION=24h

# Access without a login: deny-all | read-only | write-only | read-write
NTFY_AUTH_DEFAULT_ACCESS=deny-all

# TRACE | DEBUG | INFO | WARN | ERROR
NTFY_LOG_LEVEL=INFO

# Admin user created on a new install. The password is asked for, or passed as
# ADMIN_PASSWORD in the environment. It is never stored.
ADMIN_USER=

# Set by the installer
COMPOSE_FILE=
